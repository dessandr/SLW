! Full analytic dJ_tensor/du from qe2pert EPR electron-phonon data.
! MPI partitions target/displacement-axis tasks; rank 0 writes the HDF5 file.
&control
  calculation = 'dj',
  prefix = 'sample',
  outdir = './slw-tmp',
  verbosity = 'high'
/

&parallel
  execution = 'auto'
/

&exchange
  input_format = 'epr',
  ltensor = .true.,
  tensor_kernel = 'tb2j',
  epr_up = './input/sample_up_epr.h5',
  epr_dn = './input/sample_dn_epr.h5',
  hr_unit = 'ry',
  eph_unit = 'ry',
  efermi = 0.0,
  kmesh = 4, 4, 4,
  qmesh = 2, 2, 2,
  mag_atoms = 0, 1,
  mag_atoms_base = 0,
  slices = '0:0:5,1:5:10',
  targets = 0, 1,
  disp_axes = 'xyz',
  tensor_axes = 'xyz',
  spin_direction = 0.0, 0.0, 1.0,
  onsite_deriv_projector = .true.,
  n_shells = 1,
  integrator = 'contour',
  ! Small smoke-test value; increase and converge for production.
  empoints = 32,
  nproc = 1,
  numba_threads = 1,
  blas_threads = 1,
  checkpoint = 1
/
