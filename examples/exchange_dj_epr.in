! Scalar analytic dJ/du from qe2pert EPR electron-phonon data.
! qmesh must be compatible with the EPR qc_dim and divide kmesh.
&control
  calculation = 'dj',
  prefix = 'sample',
  outdir = './slw-tmp',
  verbosity = 'high'
/

&parallel
  execution = 'auto',
  ! MPI distributes target-axis EPC-cache ownership before splitting energy.
  ! Rank-local worker processes share only that rank's assigned cache entries.
  workers_per_rank = 1,
  threads_per_worker = 1,
  precache_workers = 1
/

&exchange
  input_format = 'epr',
  ltensor = .false.,
  epr_up = './input/sample_up_epr.h5',
  epr_dn = './input/sample_dn_epr.h5',
  hr_unit = 'ry',
  eph_unit = 'ry',
  efermi = 0.0,
  kmesh = 4, 4, 4,
  qmesh = 2, 2, 2,
  mag_atoms = 0, 1,
  mag_atoms_base = 0,
  slices = '0:0:5,1:5:10',
  targets = 'all',
  axes = 'xyz',
  ! Rank 0 projects target, bond, Rp, and Cartesian vector together under the
  ! detected space group after MPI integration.
  covariant_symmetry = 'project',
  covariant_symmetry_tolerance_mev_per_ang = 1.0d-8,
  g_transform = 'kq',
  ! direct is the full-matrix reference. spectral is an exact full-band
  ! eigenbasis assembly that computes only magnetic-endpoint GgG blocks.
  g_kernel = 'direct',
  ddelta_mode = 'off',
  n_shells = 1,
  integrator = 'contour',
  ! Small smoke-test value; increase and converge for production.
  empoints = 32
/
