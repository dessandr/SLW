! Tensor J from a native spinor Wannier90 Hamiltonian.
! The HR file already contains SOC/noncollinearity; do not add another SOC card.
! win + centres assign Wannier functions to atoms, so slices are unnecessary.
&control
  calculation = 'j',
  prefix = 'sample_spinor',
  outdir = './slw-tmp',
  verbosity = 'normal'
/

&parallel
  ! Set the MPI rank count in the launcher, not in this input file.
  execution = 'auto',
  workers_per_rank = 1,
  threads_per_worker = 1
/

&exchange
  input_format = 'wannier',
  ltensor = .true.,
  tensor_kernel = 'tb2j',

  spinor_hr = './input/sample_spinor_hr.dat',
  win = './input/sample.win',
  centres = './input/sample_centres.xyz',
  ! 'orbital': orb1-up,orb1-down,orb2-up,orb2-down,...
  ! Use 'spin' only for all-up orbitals followed by all-down orbitals.
  groupby = 'orbital',

  hr_unit = 'ev',
  efermi = 0.0,
  kmesh = 4, 4, 4,
  mag_atoms = 0, 1,
  mag_atoms_base = 0,

  axes = 'xyz',
  n_shells = 1,
  all_bonds = .true.,
  integrator = 'contour',
  ! Small syntax-test value; converge this for production.
  empoints = 64
/
