&control
  calculation = 'gkq',
  prefix = 'sample',
  outdir = './slw-tmp',
  verbosity = 'normal'
/

&epr
  epr = './input/sample_epr.h5',
  out = '${savedir}/gkq.h5',
  rotate = .true.,
  u_mat = './input/sample_u.mat',
  ! Portable local-worker default; allocate parallel resources in the launcher.
  nproc = 1,
  mode_block = 6
/
