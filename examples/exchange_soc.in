&control
  calculation = 'j',
  prefix = 'sample_soc',
  outdir = './slw-tmp',
  verbosity = 'high'
/

&parallel
  execution = 'auto'
/

&exchange
  input_format = 'wannier',
  ltensor = .true.,
  tensor_kernel = 'tb2j',
  spinor_hr = './input/sample_spinor_hr.dat',
  groupby = 'orbital',
  win = './input/sample.win',
  centres = './input/sample_centres.xyz',
  efermi = 0.0,
  kmesh = 4, 4, 4,
  mag_atoms = 0, 1,
  slices = '0:0:5,1:5:10',
  nproc = 1
/

SOC (atomic)
  LAMBDA Te-p  0.50
  LAMBDA Mn1-d 0.05
