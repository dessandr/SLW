! Scalar LKAG J from a collinear qe2pert EPR pair.
! Replace every path, mesh, atom index, slice, and energy with system values.
&control
  calculation = 'j',
  prefix = 'sample',
  outdir = './slw-tmp',
  verbosity = 'normal'
/

&parallel
  execution = 'auto',
  workers_per_rank = 1,
  threads_per_worker = 1
/

&exchange
  input_format = 'epr',
  ltensor = .false.,
  epr_up = './input/sample_up_epr.h5',
  epr_dn = './input/sample_dn_epr.h5',
  hr_unit = 'ry',
  efermi = 0.0,
  kmesh = 4, 4, 4,
  mag_atoms = 0, 1,
  mag_atoms_base = 0,
  slices = '0:0:5,1:5:10',
  n_shells = 1,
  ! Canonical J uses one mean value per validated spglib bond orbit.
  ! Distinct directional orbits (for example 10a and 10b) remain separate.
  orbit_symmetry = 'project',
  integrator = 'contour',
  ! Small smoke-test value; perform an empoints convergence study.
  empoints = 64
/
