&control
  calculation = 'lifetime',
  prefix = 'sample',
  outdir = './slw-tmp',
  verbosity = 'normal'
/

&parallel
  execution = 'auto',
  ! Native lifetime uses MPI ranks over external k and vectorized threads
  ! within each rank; local process workers are intentionally disabled.
  workers_per_rank = 1,
  threads_per_worker = 1,
  q_chunk_size = 64,
  bond_chunk_size = 64,
  vertex_q_chunk_size = 64,
  self_energy_q_chunk_size = 64
/

&magph
  exchange_h5 = '${savedir}/sample.j.h5',
  derivative_h5 = '${savedir}/sample.dj.h5',
  phonon_cache = '${savedir}/phonon_cache.npz',
  magnetic_order = 'fm',
  spin_magnitudes = 1.0,
  quantization_axis = 0.0, 0.0, 1.0,
  ! Optional static single-ion anisotropy uses the same magnon Hamiltonian as
  ! the dispersion and lifetime stages. Supply the complete set together:
  ! anisotropy_model = 'uniaxial',
  ! anisotropy_mev = 0.05,
  ! anisotropy_axis = 0.0, 0.0, 1.0,
  ! anisotropy_normalization = 'unit_vector',
  kmesh = 4, 4, 4,
  kshift = 0.5, 0.5, 0.5,
  temperature_k = 300.0,
  broadening_mev = 0.2,
  asr_policy = 'fail',
  output = '${savedir}/sample.lifetime.npz',
  restart_mode = 'error'
/
