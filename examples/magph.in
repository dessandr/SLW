&control
  calculation = 'hybrid',
  prefix = 'sample',
  outdir = './slw-tmp',
  verbosity = 'high'
/

&parallel
  execution = 'auto',
  ! Compatibility hybrid maps this to both phonon and LSWT local pools.
  workers_per_rank = 8,
  threads_per_worker = 1
/

&magph
  j_tensor_h5 = '${savedir}/sample.j_tensor.h5',
  dj_tensor_h5 = '${savedir}/sample.dj_tensor.h5',
  phonon_cache = '${savedir}/phonon_cache.npz',
  out_dir = '${savedir}',
  output = '${savedir}/magph.npz',
  s = 1.0,
  spin_direction = 0.0, 0.0, 1.0,
  kmesh = 4, 4, 4,
  qpath = 'G 0 0 0 X 0.5 0 0',
  path_points = 101,
  show = .false.
/
